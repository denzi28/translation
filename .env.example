# Postgres connection string.
#
# Supabase (production): use the *connection pooler* string, port 6543.
#   DATABASE_URL=postgresql://app_user.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Local development against a plain Postgres server:
#   DATABASE_URL=postgresql://app_user:localpw@127.0.0.1:5432/postgres?sslmode=disable
DATABASE_URL=
